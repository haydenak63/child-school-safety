generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id                  String   @id @default(cuid())
  name                String
  address             String
  timezone            String   @default("Asia/Karachi")
  scanCooldownSeconds Int      @default(10)
  matchThreshold      Float    @default(0.58)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  admins       Admin[]
  students     Student[]
  parents      Parent[]
  terminals    Terminal[]
  integration  SchoolIntegration?
  subscription SchoolSubscription?
}

enum IntegrationTestStatus {
  OK
  AUTH_FAILED
  REMOTE_DISABLED
  SUBSCRIPTION_INACTIVE
  INVALID_PAYLOAD
  RATE_LIMITED
  SERVER_ERROR
  UNREACHABLE
  UNEXPECTED
}

/// Per-school IQ Pigeon connection. Credentials belong to the school's own IQ
/// Pigeon client account, so they live here rather than in the environment.
model SchoolIntegration {
  id              String                 @id @default(cuid())
  schoolId        String                 @unique
  enabled         Boolean                @default(false)
  baseUrl         String
  apiKeyEncrypted String                 @db.Text
  apiKeyHint      String
  secretEncrypted String                 @db.Text
  secretHint      String
  lastTestedAt    DateTime?
  lastStatus      IntegrationTestStatus?
  lastError       String?                @db.Text
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model Admin {
  id                String    @id @default(cuid())
  schoolId          String
  email             String    @unique
  passwordHash      String
  name              String
  platformOperator  Boolean   @default(false)
  emailVerifiedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  school                      School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  emailVerificationTokens     EmailVerificationToken[]
  passwordResetTokens         PasswordResetToken[]
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  adminId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  adminId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

enum EmailLogStatus {
  SENT
  FAILED
  SKIPPED
}

model EmailLog {
  id        String         @id @default(cuid())
  to        String
  subject   String
  template  String
  status    EmailLogStatus
  error     String?        @db.Text
  createdAt DateTime       @default(now())
}

enum BillingPlan {
  STARTER
  GROWTH
  CAMPUS
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
}

enum GatewayMode {
  TEST
  LIVE
}

/// One row per school. Plan changes through checkout stay blocked until
/// PlatformSettings.billingEnabled is turned on.
model SchoolSubscription {
  id               String             @id @default(cuid())
  schoolId         String             @unique
  plan             BillingPlan        @default(STARTER)
  status           SubscriptionStatus @default(TRIALING)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  assignedManually Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  school           School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

/// Singleton platform config (id = "default"). Gateway secrets are encrypted
/// with AUTH_SECRET. billingEnabled stays false until a gateway is ready.
model PlatformSettings {
  id        String   @id @default("default")
  updatedAt DateTime @updatedAt

  billingEnabled Boolean @default(false)
  currency       String  @default("PKR")
  trialDays      Int     @default(14)

  stripeEnabled                 Boolean     @default(false)
  stripeMode                    GatewayMode @default(TEST)
  stripePublishableKey          String?
  stripeSecretEncrypted         String?     @db.Text
  stripeSecretHint              String?
  stripeWebhookSecretEncrypted  String?     @db.Text
  stripeWebhookHint             String?

  paypakEnabled         Boolean @default(false)
  paypakMerchantId      String?
  paypakApiUrl          String?
  paypakSecretEncrypted String? @db.Text
  paypakSecretHint      String?

  jazzcashEnabled                  Boolean @default(false)
  jazzcashMerchantId               String?
  jazzcashPasswordEncrypted        String? @db.Text
  jazzcashPasswordHint             String?
  jazzcashIntegrityEncrypted       String? @db.Text
  jazzcashIntegrityHint            String?

  smtpEnabled       Boolean @default(false)
  smtpHost          String?
  smtpPort          Int     @default(587)
  smtpUser          String?
  smtpFrom          String?
  smtpPassEncrypted String? @db.Text
  smtpPassHint      String?
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

model Student {
  id            String        @id @default(cuid())
  schoolId      String
  studentNumber String
  firstName     String
  lastName      String
  photo         String?
  className     String
  section       String
  status        StudentStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  school        School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parents       StudentParent[]
  fingerprints  FingerprintTemplate[]
  attendance    AttendanceEvent[]
  notifications NotificationLog[]
  enrollments   EnrollmentSession[]

  @@unique([schoolId, studentNumber])
}

model Parent {
  id             String   @id @default(cuid())
  schoolId       String
  name           String
  relationship   String
  whatsappNumber String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school   School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students StudentParent[]
}

model StudentParent {
  studentId String
  parentId  String
  isPrimary Boolean @default(false)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@id([studentId, parentId])
}

model FingerprintTemplate {
  id           String   @id @default(cuid())
  studentId    String
  templateData String   @db.Text
  finger       String   @default("UNKNOWN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

enum TerminalStatus {
  ACTIVE
  REVOKED
}

model Terminal {
  id             String         @id @default(cuid())
  schoolId       String
  name           String
  location       String
  tokenHash      String         @unique
  tokenEncrypted String         @db.Text
  status         TerminalStatus @default(ACTIVE)
  lastActivityAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  school     School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  attendance AttendanceEvent[]
}

enum AttendanceEventType {
  ARRIVAL
  DEPARTURE
}

model AttendanceEvent {
  id         String               @id @default(cuid())
  studentId  String
  terminalId String
  eventType  AttendanceEventType
  confidence Float
  timestamp  DateTime             @default(now())
  createdAt  DateTime             @default(now())

  student       Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  terminal      Terminal          @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  notifications NotificationLog[]

  @@index([studentId, timestamp])
  @@index([timestamp])
}

enum NotificationChannel {
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  MOCKED
}

model NotificationLog {
  id                String              @id @default(cuid())
  studentId         String
  attendanceEventId String
  channel           NotificationChannel @default(WHATSAPP)
  recipient         String
  message           String              @db.Text
  status            NotificationStatus
  sentAt            DateTime?
  createdAt         DateTime            @default(now())

  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendanceEvent AttendanceEvent @relation(fields: [attendanceEventId], references: [id], onDelete: Cascade)
}

model EnrollmentSession {
  id        String    @id @default(cuid())
  studentId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}
